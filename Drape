  const orders = ordersStore.orders;
  return (
    <div className="page fade-in">
      <div className="page-header"><div className="page-header-inner"><button className="back-btn" onClick={()=>onNavigate("home")}>←</button><span className="page-title">Order History</span></div></div>
      {!orders.length ? (
        <div className="empty-state"><div className="empty-icon">📦</div><h2 className="empty-title">No orders yet</h2><p className="empty-desc">Start shopping to see orders here!</p><button className="btn btn-primary" onClick={()=>onNavigate("home")}>Shop Now →</button></div>
      ) : (
        <div className="orders-list">
          <h2 style={{fontFamily:"'Unbounded',sans-serif",fontWeight:900,fontSize:"1.1rem",marginBottom:"0.5rem"}}>{orders.length} Orders</h2>
          {orders.map(order=>(
            <div key={order.id} className="order-row" onClick={()=>onNavigate("confirmation",order.orderNumber)}>
              <div><div className="order-num">{order.orderNumber}</div><div className="order-date">{new Date(order.createdAt).toLocaleDateString()}</div></div>
              <div><div style={{fontSize:"0.8rem",color:"#888"}}>Customer</div><div style={{fontWeight:600,fontSize:"0.9rem"}}>{order.customerName}</div></div>
              <div className="order-amount">{fmt(order.totalAmount)}</div>
              <StatusBadge status={order.status} />
            </div>
          ))}
        </div>
      )}
