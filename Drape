}

// ─── ADMIN ────────────────────────────────────────────────────────────────────
function AdminDashboard({ onNavigate }) {
  const { products, addProduct, deleteProduct, updateImage } = useProducts();
  const toast = useToast();
  const [tab, setTab] = useState("products");
  const [orders, setOrders] = useState(ordersStore.orders);
  const [form, setForm] = useState({ name:"", description:"", category:"", price:"", stock:"" });
  const [newImage, setNewImage] = useState(null);
  const [editingImageId, setEditingImageId] = useState(null);
  const [editImageVal, setEditImageVal] = useState(null);

  const handleCreate = (e) => {
    e.preventDefault();
    if (!form.name||!form.category||!form.price) { toast("Fill required fields","error"); return; }
    addProduct({ ...form, stock:parseInt(form.stock)||0, imageUrl:newImage||null });
    setForm({ name:"",description:"",category:"",price:"",stock:"" });
    setNewImage(null);
    toast("Product created!");
  };

  const handleStatusUpdate = (orderId, status) => {
    const idx = ordersStore.orders.findIndex(o=>o.id===orderId);
    if (idx>-1) ordersStore.orders[idx].status=status;
    setOrders([...ordersStore.orders]);
    toast(`Order marked as ${status}`);
  };

  const saveEditImage = (id) => {
    updateImage(id, editImageVal);
    setEditingImageId(null);
    setEditImageVal(null);
    toast("Image updated!");
  };

  return (
    <div className="page fade-in">
      <div className="page-header">
        <div className="page-header-inner">
          <button className="back-btn" onClick={()=>onNavigate("home")}>←</button>
          <span className="page-title">Admin Dashboard</span>
          <span className="badge badge-mint" style={{marginLeft:"auto"}}>Admin</span>
        </div>
      </div>
      <div className="admin-layout">
        <div className="tabs">
          <button className={`tab ${tab==="products"?"active":""}`} onClick={()=>setTab("products")}>Products</button>
          <button className={`tab ${tab==="orders"?"active":""}`} onClick={()=>setTab("orders")}>Orders</button>
        </div>

        {tab==="products" && (
          <div style={{display:"flex",flexDirection:"column",gap:"1.5rem"}}>
            {/* Add product form */}
            <div className="card">
              <div className="card-header"><span className="card-title">Add New Product</span></div>
              <div className="card-body">
                <form onSubmit={handleCreate}>
                  <div className="form-row" style={{marginBottom:"1rem"}}>
                    <div className="form-group"><label className="label">Product Name *</label><input className="input" value={form.name} onChange={e=>setForm(f=>({...f,name:e.target.value}))} placeholder="Classic Kameez" /></div>
                    <div className="form-group"><label className="label">Category *</label><input className="input" value={form.category} onChange={e=>setForm(f=>({...f,category:e.target.value}))} placeholder="kameez" /></div>
                  </div>
                  <div className="form-group" style={{marginBottom:"1rem"}}><label className="label">Description</label><input className="input" value={form.description} onChange={e=>setForm(f=>({...f,description:e.target.value}))} placeholder="Product description..." /></div>
                  <div className="form-row" style={{marginBottom:"1rem"}}>
                    <div className="form-group"><label className="label">Price (৳) *</label><input className="input" type="number" value={form.price} onChange={e=>setForm(f=>({...f,price:e.target.value}))} placeholder="4999" /></div>
                    <div className="form-group"><label className="label">Stock</label><input className="input" type="number" value={form.stock} onChange={e=>setForm(f=>({...f,stock:e.target.value}))} placeholder="10" /></div>
                  </div>
                  <div className="form-group" style={{marginBottom:"1.25rem"}}>
                    <label className="label">Product Image</label>
                    <ImageUpload value={newImage} onChange={setNewImage} />
                  </div>
                  <button type="submit" className="btn btn-primary">+ Add Product</button>
                </form>
              </div>
            </div>

            {/* Product list */}
            <div className="card">
              <div className="card-header"><span className="card-title">Products ({products.length})</span></div>
              {products.map(p => {
                const pal = getCategoryColor(p.category);
                const isEditing = editingImageId === p.id;
                return (
                  <div key={p.id}>
                    <div className="admin-product-row">
                      <div style={{display:"flex",alignItems:"center",gap:12,flex:1,minWidth:0}}>
                        {p.imageUrl
                          ? <img src={p.imageUrl} alt={p.name} className="admin-thumb" />
                          : <div className="admin-thumb-placeholder" style={{background:pal.bg}}>{CATEGORY_ICONS[p.category]||"👗"}</div>
                        }
                        <div style={{minWidth:0}}>
                          <div className="admin-product-name">{p.name}</div>
                          <div className="admin-product-meta">{p.category} · {fmt(p.price)} · Stock: {p.stock}</div>
                        </div>
                      </div>
                      <div style={{display:"flex",gap:8,flexShrink:0}}>
                        <button className="btn btn-outline btn-sm" onClick={()=>{ setEditingImageId(isEditing?null:p.id); setEditImageVal(p.imageUrl); }}>
                          {isEditing?"✕ Cancel":"📸 Image"}
                        </button>
                        <button className="btn btn-danger btn-sm" onClick={()=>{ deleteProduct(p.id); toast("Deleted"); }}>Delete</button>
                      </div>
                    </div>
                    {isEditing && (
                      <div style={{padding:"1rem 1.5rem",background:"#fafafa",borderBottom:"1.5px solid #f0f0f0"}}>
                        <div style={{maxWidth:320}}>
                          <label className="label" style={{marginBottom:8}}>Upload / Change Image for "{p.name}"</label>
                          <ImageUpload value={editImageVal} onChange={setEditImageVal} />
                          <button className="btn btn-primary btn-sm" style={{marginTop:10}} onClick={()=>saveEditImage(p.id)}>Save Image</button>
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {tab==="orders" && (
          <div className="card">
            <div className="card-header"><span className="card-title">Orders ({orders.length})</span></div>
            {!orders.length ? <div style={{padding:"2rem",textAlign:"center",color:"#888"}}>No orders yet.</div>
              : orders.map(order=>(
                <div key={order.id} style={{padding:"1.25rem 1.5rem",borderBottom:"2px solid #f0f0f0"}}>
                  <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start",marginBottom:"0.75rem",flexWrap:"wrap",gap:8}}>
                    <div>
                      <div style={{fontFamily:"'Unbounded',sans-serif",fontWeight:700,fontSize:"0.85rem"}}>{order.orderNumber}</div>
                      <div style={{fontSize:"0.82rem",color:"#888"}}>{order.customerName} · {order.customerEmail}</div>
                    </div>
                    <div style={{fontFamily:"'Unbounded',sans-serif",fontWeight:900,color:"var(--coral)"}}>{fmt(order.totalAmount)}</div>
                  </div>
                  <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",flexWrap:"wrap",gap:8}}>
                    <StatusBadge status={order.status} />
                    <div style={{display:"flex",gap:8}}>
                      {order.status!=="shipped"&&order.status!=="delivered"&&order.status!=="cancelled"&&<button className="btn btn-outline btn-sm" onClick={()=>handleStatusUpdate(order.id,"shipped")}>Mark Shipped</button>}
                      {order.status!=="delivered"&&order.status!=="cancelled"&&<button className="btn btn-accent btn-sm" onClick={()=>handleStatusUpdate(order.id,"delivered")}>Mark Delivered</button>}
                      {order.status!=="cancelled"&&<button className="btn btn-danger btn-sm" onClick={()=>handleStatusUpdate(order.id,"cancelled")}>Cancel</button>}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        )}
      </div>
    </div>
  );
}

// ─── APP ──────────────────────────────────────────────────────────────────────
export default function App() {
  const [route, setRoute] = useState({ page:"home", param:null });
  const navigate = (page, param=null) => setRoute({ page, param });

  const renderPage = () => {
    switch (route.page) {
      case "home":         return <Home onNavigate={navigate} />;
      case "product":      return <ProductDetail productId={route.param} onNavigate={navigate} />;
      case "cart":         return <CartPage onNavigate={navigate} />;
      case "checkout":     return <CheckoutPage onNavigate={navigate} />;
      case "confirmation": return <OrderConfirmation orderNumber={route.param} onNavigate={navigate} />;
      case "orders":       return <OrdersPage onNavigate={navigate} />;
      case "admin":        return <AdminDashboard onNavigate={navigate} />;
      default:             return <Home onNavigate={navigate} />;
    }
  };

  return (
    <ProductsProvider>
      <CartProvider>
        <ToastProvider>
          <style>{STYLES}</style>
          <div className="app">
            {route.page !== "confirmation" && <Header onNavigate={navigate} />}
            {renderPage()}
          </div>
        </ToastProvider>
      </CartProvider>
    </ProductsProvider>
  );
}
