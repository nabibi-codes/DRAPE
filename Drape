// ─── PRODUCT IMAGE DISPLAY ────────────────────────────────────────────────────
function ProductImg({ product, style = {}, className = "" }) {
  const pal = getCategoryColor(product.category);
  if (product.imageUrl) {
    return <img src={product.imageUrl} alt={product.name} style={{ width:"100%", height:"100%", objectFit:"cover", ...style }} className={className} />;
  }
  return (
    <div style={{ width:"100%", height:"100%", background: pal.bg, display:"flex", alignItems:"center", justifyContent:"center", ...style }} className={className}>
      <span style={{ fontSize:"4rem", filter:"drop-shadow(2px 2px 0 rgba(0,0,0,0.1))" }}>{CATEGORY_ICONS[product.category] || "👗"}</span>
    </div>
  );
}

// ─── IMAGE UPLOAD WIDGET ──────────────────────────────────────────────────────
function ImageUpload({ value, onChange }) {
  const [drag, setDrag] = useState(false);
  const inputRef = useRef();

  const handleFile = (file) => {
    if (!file || !file.type.startsWith("image/")) return;
    const reader = new FileReader();
    reader.onload = (e) => onChange(e.target.result);
    reader.readAsDataURL(file);
  };

  return (
    <div>
      {value ? (
        <div className="img-preview">
          <img src={value} alt="preview" />
          <button className="img-remove" onClick={() => onChange(null)} title="Remove">✕</button>
        </div>
      ) : (
        <div className={`upload-zone ${drag ? "drag" : ""}`}
          onDragOver={e => { e.preventDefault(); setDrag(true); }}
          onDragLeave={() => setDrag(false)}
          onDrop={e => { e.preventDefault(); setDrag(false); handleFile(e.dataTransfer.files[0]); }}
          onClick={() => inputRef.current.click()}
        >
          <input ref={inputRef} type="file" accept="image/*" onChange={e => handleFile(e.target.files[0])} style={{display:"none"}} />
          <div className="upload-zone-icon">📸</div>
          <div className="upload-zone-label">Click or drag & drop image</div>
          <div className="upload-zone-sub">JPG, PNG, WEBP supported</div>
        </div>
      )}
    </div>
  );
}

