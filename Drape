      <div className="page-header"><div className="page-header-inner"><span className="page-title">Order Confirmation</span></div></div>
      <div className="confirmation-hero">
        <div className="success-ring">✓</div>
        <h2 style={{fontFamily:"'Unbounded',sans-serif",fontSize:"1.6rem",fontWeight:900,marginBottom:"0.75rem"}}>Order Placed!</h2>
        <p style={{color:"#666",marginBottom:"0.5rem"}}>Your order is confirmed and will ship soon.</p>
        <p style={{fontSize:"0.85rem",color:"#888"}}>Confirmation sent to <strong>{order.customerEmail}</strong></p>
      </div>
      <div className="order-detail-grid">
        <div style={{display:"flex",flexDirection:"column",gap:"1.25rem"}}>
          <div className="card">
            <div className="card-header"><span className="card-title">Order Details</span></div>
            <div className="card-body" style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:"1.5rem"}}>
              <div><div style={{fontSize:"0.75rem",color:"#888",marginBottom:4}}>Order Number</div><div style={{fontFamily:"'Unbounded',sans-serif",fontWeight:900,fontSize:"0.9rem"}}>{order.orderNumber}</div></div>
              <div><div style={{fontSize:"0.75rem",color:"#888",marginBottom:4}}>Status</div><StatusBadge status={order.status} /></div>
              <div><div style={{fontSize:"0.75rem",color:"#888",marginBottom:4}}>Date</div><div style={{fontWeight:600}}>{new Date(order.createdAt).toLocaleDateString()}</div></div>
              <div><div style={{fontSize:"0.75rem",color:"#888",marginBottom:4}}>Est. Delivery</div><div style={{fontWeight:600}}>{estDelivery.toLocaleDateString()}</div></div>
            </div>
          </div>
          <div className="card">
            <div className="card-header"><span className="card-title">Items Ordered</span></div>
            <div className="card-body" style={{display:"flex",flexDirection:"column",gap:10}}>
              {order.items.map((item,i)=>(
                <div key={i} style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"0.75rem",background:"#f9f9f9",borderRadius:10}}>
                  <div><div style={{fontWeight:700,fontSize:"0.9rem"}}>{item.productName}</div><div style={{fontSize:"0.8rem",color:"#888",marginTop:2}}>{item.size&&`Size: ${item.size}`} {item.color&&`· ${item.color}`} · Qty: {item.quantity}</div></div>
                  <div style={{fontFamily:"'Unbounded',sans-serif",fontWeight:900,color:"var(--coral)"}}>{fmt(item.subtotal)}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div>
          <div className="card summary-card">
            <div className="card-header"><span className="card-title">Price Summary</span></div>
            <div className="card-body">
              <div className="summary-row"><span>Subtotal</span><span>{fmt(order.subtotal)}</span></div>
              <div className="summary-row"><span>VAT</span><span>{fmt(order.taxAmount)}</span></div>
              <div className="summary-row" style={{borderBottom:"none"}}><span style={{fontWeight:700}}>Total</span><span className="summary-total">{fmt(order.totalAmount)}</span></div>
              <div style={{marginTop:"1.5rem",display:"flex",flexDirection:"column",gap:10}}>
                <button className="btn btn-primary btn-full" onClick={()=>onNavigate("home")}>Continue Shopping</button>
                <button className="btn btn-outline btn-full" onClick={()=>onNavigate("orders")}>View All Orders</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

// ─── ORDERS ───────────────────────────────────────────────────────────────────
