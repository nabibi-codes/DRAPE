    e.preventDefault();
    if (!form.customerName||!form.customerEmail||!form.customerPhone) { toast("Fill in personal details","error"); return; }
    if (!form.shippingAddress||!form.shippingCity||!form.shippingZip) { toast("Fill in shipping address","error"); return; }
