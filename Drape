              </div>
              <p className="form-section-title">Shipping Address</p>
              <div className="form-group"><label className="label">Street Address *</label><input className="input" name="shippingAddress" value={form.shippingAddress} onChange={handle} placeholder="House 12, Road 4, Dhanmondi" required /></div>
              <div className="form-row">
                <div className="form-group"><label className="label">City *</label><input className="input" name="shippingCity" value={form.shippingCity} onChange={handle} placeholder="Dhaka" required /></div>
